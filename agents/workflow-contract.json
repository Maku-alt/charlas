{
  "contract_version": 2,
  "product": "web-talk",
  "current_summary": "notes/phase-summary.md",
  "required_sentinel_fields": ["contract_version", "run_id", "phase", "attempt", "execution_status", "summary", "completed_at"],
  "execution_statuses": ["completed", "blocked"],
  "decisions": ["advance", "iterate", "return", "stop"],
  "review_verdicts": ["not_applicable", "approved", "requires_changes"],
  "auxiliary_roles": {
    "advisor-charlas": {
      "role": "agents/advisor-charlas.md",
      "request_template": "templates/charlas-sdd/advisor-request.md",
      "prompt": "templates/charlas-sdd/prompts/run-advisor.md",
      "owns_phase": false,
      "may_modify_artifacts": false,
      "may_write_phase_summary": false,
      "may_approve": false,
      "may_block": false
    }
  },
  "phases": {
    "thesis-review": {
      "sentinel": ".phase-thesis-review.done",
      "next": ["research", "narrative", "stop"],
      "role": "orchestrator-charlas or researcher-charlas",
      "spec": "thesis-spec.md",
      "prompt": "run-thesis-review.md",
      "required_inputs": ["talk brief or open thesis", "thesis specification"],
      "required_outputs": ["thesis decision", "phase summary"],
      "allows_parallel_with": []
    },
    "research": {
      "sentinel": ".phase-research.done",
      "next": ["narrative", "thesis-review", "stop"],
      "role": "researcher-charlas",
      "spec": "research-spec.md",
      "prompt": "run-research.md",
      "required_inputs": ["research specification", "thesis or research question"],
      "required_outputs": ["research package", "claims and contradictions", "bibliography when external sources are used", "phase summary"],
      "allows_parallel_with": []
    },
    "narrative": {
      "sentinel": ".phase-narrative.done",
      "next": ["build", "research"],
      "role": "narrative-charlas",
      "spec": "narrative-spec.md",
      "prompt": "run-narrative.md",
      "required_inputs": ["narrative specification", "converged thesis", "approved research when required"],
      "required_outputs": ["approved web-talk narrative", "moment sequence", "speech", "visual proof concepts", "phase summary"],
      "allows_parallel_with": []
    },
    "build": {
      "sentinel": ".phase-build.done",
      "next": ["review", "narrative"],
      "role": "experience-designer-builder-charlas",
      "spec": "build-spec.md",
      "prompt": "run-build.md",
      "required_inputs": ["build specification", "approved narrative", "speech", "source and asset policy"],
      "required_outputs": ["self-contained HTML candidate", "frontend source", "individual renders", "runtime tests", "self-audit", "phase summary"],
      "allows_parallel_with": []
    },
    "review": {
      "sentinel": ".phase-review.done",
      "next": ["release", "build-fix", "narrative", "stop"],
      "role": "review-charlas",
      "spec": "review-spec.md",
      "prompt": "run-review.md",
      "required_inputs": ["review specification", "exact HTML candidate and hash", "narrative", "build evidence", "phase summary"],
      "required_outputs": ["independent review verdict", "actionable review report", "fix list when required", "phase summary"],
      "allows_parallel_with": [],
      "must_be_independent_from": ["build", "build-fix"]
    },
    "build-fix": {
      "sentinel": ".phase-build-fix.done",
      "next": ["review-final"],
      "role": "experience-designer-builder-charlas",
      "spec": "build-spec.md",
      "prompt": "run-build.md",
      "required_inputs": ["review phase summary", "fix list", "current HTML candidate and source", "localized acceptance criteria"],
      "required_outputs": ["corrected HTML candidate", "regression evidence", "fresh renders", "phase summary"],
      "allows_parallel_with": []
    },
    "review-final": {
      "sentinel": ".phase-review-final.done",
      "next": ["release", "stop"],
      "role": "review-charlas",
      "spec": "review-spec.md",
      "prompt": "run-review.md",
      "required_inputs": ["review specification", "corrected HTML candidate and hash", "build-fix summary", "initial review report", "regression evidence"],
      "required_outputs": ["independent final verdict", "final review report", "phase summary"],
      "allows_parallel_with": [],
      "must_be_independent_from": ["build", "build-fix"]
    },
    "release": {
      "sentinel": ".phase-release.done",
      "next": [],
      "role": "orchestrator-charlas",
      "spec": "embedded release contract",
      "prompt": "not_applicable",
      "required_inputs": ["approved review or review-final verdict", "approved HTML candidate hash", "current phase summary"],
      "required_outputs": ["promoted Web Talk with recomputed SHA256", "release metadata", "release phase summary"],
      "allows_parallel_with": []
    }
  }
}
