{
  "contract_version": 2,
  "current_summary": "notes/phase-summary.md",
  "required_sentinel_fields": [
    "contract_version",
    "run_id",
    "phase",
    "attempt",
    "execution_status",
    "summary",
    "completed_at"
  ],
  "execution_statuses": ["completed", "blocked"],
  "decisions": ["advance", "iterate", "return", "stop"],
  "review_verdicts": ["not_applicable", "approved", "requires_changes"],
  "auxiliary_roles": {
    "advisor-charlas": {
      "role": "agents/advisor-charlas.md",
      "request_template": "templates/charlas-sdd/advisor-request.md",
      "prompt": "templates/charlas-sdd/prompts/run-advisor.md",
      "owns_phase": false,
      "may_modify_artifacts": false,
      "may_write_phase_summary": false,
      "may_approve": false,
      "may_block": false
    }
  },
  "phases": {
    "thesis-review": {
      "sentinel": ".phase-thesis-review.done",
      "next": ["research", "stop"],
      "role": "orchestrator-charlas or researcher-charlas",
      "spec": "thesis-spec.md",
      "prompt": "run-thesis-review.md",
      "required_inputs": ["talk brief or open thesis", "thesis specification"],
      "required_outputs": ["thesis decision", "phase summary"],
      "allows_parallel_with": []
    },
    "research": {
      "sentinel": ".phase-research.done",
      "next": ["narrative", "thesis-review", "stop"],
      "role": "researcher-charlas",
      "spec": "research-spec.md",
      "prompt": "run-research.md",
      "required_inputs": ["research specification", "thesis or research question"],
      "required_outputs": ["research package", "claims and contradictions", "bibliography when external sources are used", "phase summary"],
      "allows_parallel_with": []
    },
    "narrative": {
      "sentinel": ".phase-narrative.done",
      "next": ["build", "image-close", "research"],
      "role": "narrative-charlas",
      "spec": "narrative-spec.md",
      "prompt": "run-narrative.md",
      "required_inputs": ["narrative specification", "converged thesis", "approved research when research was required"],
      "required_outputs": ["approved slide narrative", "slide sequence", "conclusion titles", "visual concepts", "defined closing direction", "phase summary"],
      "allows_parallel_with": []
    },
    "image-close": {
      "sentinel": ".phase-image-close.done",
      "next": ["build", "review", "narrative"],
      "role": "image-closer-charlas",
      "spec": "image-spec.md",
      "prompt": "run-image-close.md",
      "required_inputs": ["thesis", "final message", "real reference quote or justified fallback", "emotional tone", "closing direction"],
      "required_outputs": ["final closing asset or concrete visual direction", "phase summary"],
      "allows_parallel_with": ["build"]
    },
    "build": {
      "sentinel": ".phase-build.done",
      "next": ["review", "narrative"],
      "role": "deck-builder-charlas",
      "spec": "build-spec.md",
      "prompt": "run-build.md",
      "required_inputs": ["build specification", "narrative specification", "approved slide narrative", "closing direction"],
      "required_outputs": ["editable PPTX candidate", "source deck specification", "textual and mechanical checks", "native PowerPoint evidence", "phase summary"],
      "allows_parallel_with": ["image-close"]
    },
    "review": {
      "sentinel": ".phase-review.done",
      "next": ["release", "build-fix", "narrative", "image-close", "stop"],
      "role": "review-charlas",
      "spec": "review-spec.md",
      "prompt": "run-review.md",
      "required_inputs": ["review specification", "target deck", "build evidence", "closing visual when applicable", "phase summary"],
      "required_outputs": ["independent review verdict", "actionable review report when changes are required", "phase summary"],
      "allows_parallel_with": [],
      "must_be_independent_from": ["build", "build-fix"]
    },
    "build-fix": {
      "sentinel": ".phase-build-fix.done",
      "next": ["review-final"],
      "role": "deck-builder-charlas",
      "spec": "build-spec.md",
      "prompt": "run-build.md",
      "required_inputs": ["review phase summary", "actionable review report", "current PPTX candidate and source", "specific slides to correct", "acceptance criteria"],
      "required_outputs": ["corrected PPTX candidate", "corrected source", "fix evidence", "phase summary"],
      "allows_parallel_with": []
    },
    "review-final": {
      "sentinel": ".phase-review-final.done",
      "next": ["release", "stop"],
      "role": "review-charlas",
      "spec": "review-spec.md",
      "prompt": "run-review.md",
      "required_inputs": ["review specification", "corrected PPTX candidate", "build-fix phase summary", "initial review report", "native PowerPoint evidence for the fix"],
      "required_outputs": ["independent final review verdict", "final review report", "phase summary"],
      "allows_parallel_with": [],
      "must_be_independent_from": ["build", "build-fix"]
    },
    "release": {
      "sentinel": ".phase-release.done",
      "next": [],
      "role": "orchestrator-charlas",
      "spec": "embedded release contract",
      "prompt": "not_applicable",
      "required_inputs": ["approved review or review-final verdict for the exact candidate", "approved editable PPTX candidate hash", "current phase summary"],
      "required_outputs": ["promoted final PPTX with recomputed SHA256", "release phase summary"],
      "allows_parallel_with": []
    }
  }
}
